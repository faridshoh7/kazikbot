[Unit]
Description=Telegram bot GRAM (kazikbot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/kazikbot
EnvironmentFile=/root/kazikbot/.env
ExecStart=/root/kazikbot/venv/bin/python3 /root/kazikbot/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kazikbot

[Install]
WantedBy=multi-user.target
